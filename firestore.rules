rules_version = '2';

// Aturan keamanan Cloud Firestore — lapisan otorisasi sistem.
//
// Proteksi route di React hanya menyembunyikan tampilan. Pemeriksaan yang
// mengikat terjadi di sini, dievaluasi server pada setiap permintaan baca dan
// tulis, sesuai subbab 3.4 proposal.
//
// Status awal: semua koleksi ditolak. Setiap koleksi dibuka satu per satu
// ketika fiturnya diimplementasikan, supaya tidak ada koleksi yang terbuka
// sebelum aturannya dipikirkan.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Peran Administrator ditentukan oleh keberadaan dokumen pada koleksi
    // `administrator`, bukan oleh field yang dikirim klien. exists() di dalam
    // aturan dievaluasi server dan tidak tunduk pada aturan koleksi itu
    // sendiri, sehingga allowlist tetap tertutup bagi klien.
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/administrator/$(request.auth.uid));
    }

    // Allowlist peran. Ditambahkan manual lewat Firebase Console oleh
    // pengelola; klien tidak pernah boleh menulisnya, supaya tidak ada
    // pengguna yang dapat mengangkat dirinya sendiri.
    //
    // Seorang pengguna boleh membaca dokumen miliknya sendiri agar aplikasi
    // dapat mengetahui perannya setelah masuk. `list` tetap ditutup, sehingga
    // daftar administrator tidak dapat dikumpulkan oleh siapa pun. Membaca
    // dokumen sendiri tidak memberi hak apa pun: setiap akses ke koleksi lain
    // tetap diperiksa ulang lewat isAdmin() yang dievaluasi server.
    match /administrator/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow write: if false;
    }

    // Profil pengguna. Dokumen memakai Firebase UID sebagai pengenal, sesuai
    // pemetaan ERD pada subbab 3.3.3.
    match /pengguna/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Peran tidak boleh ikut ditulis klien — sumbernya koleksi administrator.
      allow create, update: if isOwner(uid)
        && !('role' in request.resource.data);
      allow delete: if false;
    }

    // Indeks keunikan NIM. Aturan di atas hanya mengizinkan seorang pengguna
    // membaca dokumen `pengguna` miliknya sendiri, sehingga keunikan NIM tidak
    // dapat diperiksa dengan kueri biasa. Koleksi ini menyimpan satu dokumen
    // per NIM berisi uid pemiliknya, dan tautannya dibuat dalam transaksi yang
    // sama dengan penulisan profil.
    //
    // Dokumen tidak pernah boleh diubah atau dihapus klien, supaya satu NIM
    // terkunci permanen pada satu akun. Melepas tautan adalah tindakan
    // administratif yang dilakukan lewat Firebase Console.
    match /nim_terpakai/{nim} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Pencacah nomor laporan, satu dokumen per tahun.
    //
    // Nomor laporan tidak dapat ditentukan dengan mencari nomor tertinggi pada
    // koleksi laporan, karena aturan di bawah melarang mahasiswa membaca
    // laporan milik orang lain sehingga kueri semacam itu pasti ditolak.
    // Dokumen pencacah menyelesaikannya tanpa membuka data siapa pun.
    //
    // Nilainya hanya boleh naik tepat satu setiap penulisan, sehingga pengguna
    // tidak dapat melompati atau mengulang nomor. Penurunan dan penghapusan
    // ditutup sama sekali.
    match /pencacah_laporan/{tahun} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.terakhir == 1;
      allow update: if isSignedIn()
        && request.resource.data.terakhir == resource.data.terakhir + 1;
      allow delete: if false;
    }

    // Daftar status laporan (Tabel 4.1) dan kategori laporan. Keduanya data
    // acuan yang dibaca setiap pengguna dan hanya diubah pengelola lewat
    // Console.
    match /status_laporan/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /kategori_laporan/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Laporan. Inilah penegakan pembatasan akses yang diminta subbab 3.7:
    // mahasiswa hanya dapat membaca laporan miliknya sendiri, dan pemeriksaan
    // itu dijalankan server pada setiap permintaan, bukan oleh penyaringan di
    // peramban yang dapat dilewati.
    //
    // `list` memakai syarat yang sama dengan `get`. Firestore menolak kueri
    // yang tidak dapat dibuktikan memenuhi aturan, sehingga kueri tanpa
    // penyaring uid_pelapor akan gagal, bukan diam-diam mengembalikan laporan
    // milik orang lain.
    function laporanMilikSendiri() {
      return isSignedIn() && resource.data.uid_pelapor == request.auth.uid;
    }

    match /laporan/{id} {
      allow get, list: if laporanMilikSendiri() || isAdmin();

      // Mahasiswa membuat laporan atas namanya sendiri, dan status awal wajib
      // Diterima sesuai baris pertama Tabel 4.2. Dengan begitu tidak ada
      // laporan yang lahir langsung berstatus Selesai.
      allow create: if isSignedIn()
        && request.resource.data.uid_pelapor == request.auth.uid
        && request.resource.data.id_status == 'Diterima'
        && request.resource.data.nomor_laporan is string
        && request.resource.data.judul_laporan is string;

      // Perubahan status adalah wewenang Administrator. Mahasiswa hanya boleh
      // menyunting laporannya sendiri selama status masih memungkinkan, yaitu
      // saat diminta melengkapi, dan tidak boleh memindahkan kepemilikan.
      allow update: if isAdmin()
        || (laporanMilikSendiri()
            && resource.data.id_status == 'Perlu Informasi Tambahan'
            && request.resource.data.uid_pelapor == resource.data.uid_pelapor
            && request.resource.data.nomor_laporan == resource.data.nomor_laporan
            && request.resource.data.id_status == 'Diterima');

      // Laporan tidak pernah dihapus; riwayatnya adalah bukti penanganan.
      allow delete: if false;
    }

    // Riwayat status, lampiran, dan catatan penanganan mengikuti hak akses
    // laporan induknya.
    function laporanInduk(idLaporan) {
      return get(/databases/$(database)/documents/laporan/$(idLaporan)).data;
    }

    function bolehBacaLaporan(idLaporan) {
      return isAdmin() || (isSignedIn() && laporanInduk(idLaporan).uid_pelapor == request.auth.uid);
    }

    match /riwayat_status_laporan/{id} {
      allow get, list: if isSignedIn();
      // Pencatat wajib dirinya sendiri, sehingga riwayat tidak dapat
      // dipalsukan atas nama orang lain.
      //
      // Kepemilikan laporan induk sengaja tidak diperiksa di sini. Catatan
      // riwayat pertama ditulis dalam transaksi yang sama dengan laporannya,
      // dan aturan dievaluasi terhadap keadaan sebelum transaksi tersimpan,
      // sehingga get() ke laporan induk akan selalu menemukan dokumen kosong
      // dan menolak pembuatan laporan yang sah. Pembatasan sudah memadai
      // karena uid_pencatat tidak dapat dipalsukan dan laporan induknya
      // sendiri tetap dilindungi aturannya masing-masing.
      allow create: if isSignedIn()
        && request.resource.data.uid_pencatat == request.auth.uid;
      // Hanya penanda baca notifikasi (FR-07) yang boleh berubah.
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['dibaca_pada']);
      allow delete: if false;
    }

    match /lampiran/{id} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && bolehBacaLaporan(request.resource.data.id_laporan);
      allow update, delete: if false;
    }

    // Pengiriman validasi, hasil validasi, dan tindak lanjut sepenuhnya
    // wewenang Administrator. Mahasiswa boleh membacanya pada laporannya
    // sendiri agar dapat melihat perkembangan penanganan.
    match /pengiriman_validasi/{id} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin() && request.resource.data.uid_pengirim == request.auth.uid;
      allow update, delete: if false;
    }

    match /validasi/{id} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin() && request.resource.data.uid_pencatat == request.auth.uid;
      allow update, delete: if false;
    }

    match /tindak_lanjut/{id} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin() && request.resource.data.uid_pencatat == request.auth.uid;
      allow update, delete: if false;
    }

    // Koleksi lain belum dibuka. Tambahkan blok match tersendiri saat
    // fiturnya dikerjakan.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
