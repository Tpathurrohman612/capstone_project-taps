{
  "name": "taps-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "emulators": "firebase emulators:start --project demo-taps",
    "emulators:export": "firebase emulators:start --project demo-taps --import ./.emulator-data --export-on-exit",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:rules": "vitest run src/shared/lib/firestore-rules.test.ts",
    "test:rules:emulator": "firebase --project demo-taps emulators:exec --only firestore \"corepack pnpm@10.34.3 --dir frontend run test:rules\""
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.12.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "5.0.5",
    "oxfmt": "^0.72.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.34.3"
}
