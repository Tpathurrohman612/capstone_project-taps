# Firebase web config.
#
# Salin berkas ini menjadi `.env.local` di folder yang sama, lalu isi nilainya
# dari Firebase Console → Project settings → Your apps → Web app → SDK setup
# and configuration → Config.
#
# Nilai di bawah BUKAN rahasia. Firebase mengirimkannya di dalam bundel klien
# secara sengaja; pembatasan akses ditegakkan oleh firestore.rules dan
# storage.rules, bukan oleh menyembunyikan nilai ini. `.env.local` tetap
# diabaikan Git supaya proyek mudah diganti tanpa menyunting kode.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Isi 'true' untuk mengarahkan aplikasi ke Firebase Emulator Suite lokal
# (jalankan `firebase emulators:start` dari root repositori lebih dulu).
# Biarkan kosong atau 'false' untuk memakai proyek Firebase sungguhan.
# Kunci situs reCAPTCHA v3 untuk Firebase App Check. Kosongkan untuk
# mematikan App Check, misalnya saat mengembangkan di mesin sendiri.
# Dapatkan dari Firebase Console pada App Check, lalu daftarkan aplikasi web
# dengan penyedia reCAPTCHA v3.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Penyedia App Check: 'enterprise' (bawaan, di Console bernama Fraud Defense)
# atau 'v3' untuk reCAPTCHA Classic yang sudah ditandai usang.
VITE_FIREBASE_APPCHECK_PROVIDER=

VITE_FIREBASE_USE_EMULATOR=

